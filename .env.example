# Copy to .env.local for local development (.env.local is git-ignored — never
# commit it). On Vercel, set these under Project → Settings → Environment Variables.

# Hospitable Personal Access Token (Hospitable → Apps → API access).
# It has WRITE access: it is read only by server code (src/lib/hospitable/client.ts,
# guarded by `server-only`) and must never get a NEXT_PUBLIC_ prefix.
HOSPITABLE_PAT=

# Optional. Defaults to https://public.api.hospitable.com/v2
# HOSPITABLE_API_BASE=

# Optional. Canonical origin for metadata and Open Graph. Defaults to https://wkreserve.com
# NEXT_PUBLIC_SITE_URL=

# Meta Conversions API (Purchase events for direct bookings). Secret: server only.
# Events Manager → your dataset → Settings → Conversions API → Generate access token.
META_CAPI_TOKEN=
# Any long random string. Hospitable's webhook URL must end in ?key=<this value>:
#   https://wkreserve.com/api/webhooks/hospitable?key=...
HOSPITABLE_WEBHOOK_KEY=
# Optional, for testing: the code shown in Events Manager → Test events.
# Remove it afterwards, or real bookings only show up as test events.
# META_TEST_EVENT_CODE=
# Optional. Overrides the Meta Pixel ID in src/lib/meta-pixel.ts; "off" disables the pixel.
# NEXT_PUBLIC_META_PIXEL_ID=

# Website chat assistant (Claude). Secret: server only, never NEXT_PUBLIC_.
# Anthropic Console → API keys. Without it the chat button doesn't show.
# Redeploy after adding it so the pages pick it up.
ANTHROPIC_API_KEY=

# Chat contact emails (each guest's name, phone and email, then their conversation).
# Resend (resend.com) → API Keys. Without it, the details only go to the Vercel logs.
RESEND_API_KEY=
# Optional. Who gets them; defaults to the site's contact email (stay@wkreserve.com).
# LEADS_TO_EMAIL=
# Optional. The sender. The default (onboarding@resend.dev) can only deliver to the
# email address you signed up to Resend with. After verifying wkreserve.com in Resend
# (Domains), use e.g.:  W&K Reserve <chat@wkreserve.com>
# LEADS_FROM_EMAIL=
