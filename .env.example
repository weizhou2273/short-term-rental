# Copy to .env.local for local development (.env.local is git-ignored — never
# commit it). On Vercel, set these under Project → Settings → Environment Variables.

# Hospitable Personal Access Token (Hospitable → Apps → API access).
# It has WRITE access: it is read only by server code (src/lib/hospitable/client.ts,
# guarded by `server-only`) and must never get a NEXT_PUBLIC_ prefix.
HOSPITABLE_PAT=

# Optional. Defaults to https://public.api.hospitable.com/v2
# HOSPITABLE_API_BASE=

# Optional. Canonical origin for metadata and Open Graph. Defaults to https://wkreserve.com
# NEXT_PUBLIC_SITE_URL=

# Meta Conversions API (Purchase events for direct bookings). Secret: server only.
# Events Manager → your dataset → Settings → Conversions API → Generate access token.
META_CAPI_TOKEN=
# Any long random string. Hospitable's webhook URL must end in ?key=<this value>:
#   https://wkreserve.com/api/webhooks/hospitable?key=...
HOSPITABLE_WEBHOOK_KEY=
# Optional, for testing: the code shown in Events Manager → Test events.
# Remove it afterwards, or real bookings only show up as test events.
# META_TEST_EVENT_CODE=
# Optional. Overrides the Meta Pixel ID in src/lib/meta-pixel.ts; "off" disables the pixel.
# NEXT_PUBLIC_META_PIXEL_ID=

# Website chat assistant (Claude). Secret: server only, never NEXT_PUBLIC_.
# Anthropic Console → API keys. Without it the chat button doesn't show.
# Redeploy after adding it so the pages pick it up.
ANTHROPIC_API_KEY=

# Chat contact emails (each guest's name, phone and email, then their conversation).
# Resend (resend.com) → API Keys. Without it, the details only go to the Vercel logs.
RESEND_API_KEY=
# Optional. Who gets them; defaults to the site's contact email (stay@wkreserve.com).
# LEADS_TO_EMAIL=
# The sender. The default (onboarding@resend.dev) can only deliver to the email
# address you signed up to Resend with, so guests get nothing until wkreserve.com is
# verified in Resend (Domains) and this is set, e.g.:  W&K Reserve <stay@wkreserve.com>
# (The welcome email to guests is shown as from "Edward at W&K Reserve", same address.)
# LEADS_FROM_EMAIL=

# Welcome offer popup ("5% off your first stay" for a name, email and phone).
# The code and percent are in src/data/site.ts (welcomeOffer) and must match a
# promo code that exists in Hospitable (Direct → Promo codes).
#
# With these two set, each sign-up goes straight to Go High Level as a contact
# tagged "wkreserve-5-off", and nothing goes to Resend unless that fails (then
# you are emailed the details). The token is a Private Integration token
# (Go High Level → Settings → Private Integrations) that can View and Edit
# Contacts; the location ID is the sub-account's (Settings → Business Profile).
# Server-only: never put the token in a NEXT_PUBLIC_ variable or in code.
GHL_API_TOKEN=
GHL_LOCATION_ID=
#
# Without them the popup works by email: it shows when RESEND_API_KEY is set;
# a "Full access" key also saves sign-ups to Resend Contacts (otherwise each
# is emailed to you). Emailing the code to guests needs LEADS_FROM_EMAIL on a
# verified domain.
# Optional, to use a different Hospitable code without a code change:
# WELCOME_PROMO_CODE=

# Optional. Overrides the Google Analytics 4 measurement ID in src/lib/google-analytics.ts;
# "off" disables it (e.g. on preview deployments).
# NEXT_PUBLIC_GA_ID=

# Private site report (/api/admin/stats) from Google Analytics, read with a Google
# Cloud service account that has Viewer access to the GA4 property.
# The service account's JSON key, as downloaded (or base64 of it). Secret.
GA_SERVICE_ACCOUNT_KEY=
# The GA4 property's numeric ID (Admin → Property details), not the G- measurement ID.
GA_PROPERTY_ID=
# Any long random string; the report only answers requests sending it as X-Stats-Key. Secret.
STATS_API_KEY=
