# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Everything is optional: with no values at all
# the site boots and renders the bundled demo portfolio, which is how the repo
# is meant to be explored before any accounts exist.
# ---------------------------------------------------------------------------

# Public origin. Used for canonical URLs, Open Graph tags, the sitemap and the
# return URL sent to payment providers. Must be the real https origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- OwnerRez ---------------------------------------------------------------
# Property management, availability, quoting and reservations.
# Create a Personal Access Token in OwnerRez: Settings → API → Access Tokens.
# The username is the account's login email.
OWNERREZ_API_BASE_URL=https://api.ownerrez.com/v2
OWNERREZ_USERNAME=
OWNERREZ_ACCESS_TOKEN=

# Shared secret for the OwnerRez webhook (Settings → API → Webhooks).
# Without it, unsigned deliveries are accepted and a warning is logged — fine
# while wiring things up, not acceptable in production.
OWNERREZ_WEBHOOK_SECRET=

# Optional. Restrict the public site to these OwnerRez property ids, comma
# separated. Leave blank to publish every active property on the account.
OWNERREZ_PROPERTY_IDS=


# --- WordPress (headless CMS) ------------------------------------------------
# The site origin, NOT the /wp-json path — that is appended for you.
WORDPRESS_API_URL=

# Application Password (Users → Profile → Application Passwords). Only needed
# for drafts and previews; published content is read anonymously.
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_PREVIEW_SECRET=


# --- Payments ---------------------------------------------------------------
# stripe   — on-site checkout with the Payment Element
# ownerrez — redirect to OwnerRez's hosted payment page
# auto     — Stripe when fully configured, otherwise OwnerRez (default)
PAYMENT_PROVIDER=auto

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Required for the webhook to accept anything.
STRIPE_WEBHOOK_SECRET=


# --- Security ---------------------------------------------------------------
# Signs the short-lived booking drafts that carry a quoted price between
# starting a payment and confirming it. REQUIRED in production — the app
# refuses to sign without it. Generate with:
#   openssl rand -base64 48
BOOKING_SIGNING_SECRET=

# Shared secret for POST /api/revalidate, called by WordPress on publish.
REVALIDATE_SECRET=


# --- Caching (seconds) -------------------------------------------------------
# How long property and editorial content may be served from cache.
CONTENT_REVALIDATE_SECONDS=300
# How long a calendar may be served from cache. Keep this short: it is the
# window in which a night sold on an OTA could still look bookable here.
# The OwnerRez webhook expires it immediately, so this is only the backstop.
AVAILABILITY_REVALIDATE_SECONDS=60
